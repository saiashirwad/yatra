{
  "name": "yatra",
  "version": "0.0.1",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node examples/demo.ts",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "tsc --noEmit --watch",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "prettier": {
    "printWidth": 60,
    "useTabs": false,
    "semi": false,
    "trailingComma": "none",
    "experimentalTernaries": true,
    "experimentalOperatorPosition": "end",
    "arrowParens": "avoid"
  }
}
